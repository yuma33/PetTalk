<h1 class="text-center text-gray-700 md:text-3xl text-2xl font-bold mt-5 mb-2"><%= t('.title') %></h1>
<div class="w-full max-h-md my-5">
  <div class="mx-auto border border-black md:w-150 w-120" id="board-id-<%= @board.id %>">
    <%= image_tag @board.board_image_url, class: "w-full h-50 md:h-70 mb-5 px-2 pt-2"%>
      <div class="text-center ">
        <%= link_to @board.title, board_path(@board), class: "block mb-5  ml-3 break-all text-left text-xl" %>
          <div class="flex justify-between">
            <div class="flex">
              <%= image_tag 'person_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.png' , class: 'w-6 h-6 ml-2' %>
              <ul class=" mr-2 ">
                <li class="  mb-5 text-left">
                <%= @board.user.decorate.full_name %>
                <%= l @board.created_at, format: :short %>
                </li>
              </ul>
            </div>
            <div class="flex">
              <% if current_user.own?(@board) %>
                <%= link_to edit_board_path(@board) do %>
                    <%= image_tag 'edit_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.png' , class: 'w-6 h-6' %>
                <% end %>
                <%= link_to board_path(@board), data: { turbo_method: :delete, turbo_confirm: t('defaults.delete_confirm') } do %>
                  <span class="material-symbols-outlined mr-3">
                  delete
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
          <p class="text-left mb-5  ml-3 break-all">
              <%= @board.body %>
            </p>
      </div>
  </div>
</div>

<h1 class="text-center text-gray-700 md:text-2xl text-xl font-bold mt-8 mb-2"><%= t('.comment') %></h1>
  <%= form_with model: @comment, url: board_comments_path(@board),  class: "w-full  max-w-lg md:max-w-xl mx-auto ", id: "comment_form", data: { turbo_method: :post }  do |f| %>
  <div class="flex flex-col -mx-3 mb-6">
    <div class="w-full  px-3 mb-6 md:mb-8">
        <%= f.label :body, class: "block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" %>
        <%= f.text_area :body,
        class: "appearance-none block w-full bg-gray-200 text-gray-700 border border-red-500 rounded py-3 px-4 mb-3 leading-tight focus:outline-none focus:bg-white"
        %>
    </div>
    <%= f.submit t('helpers.submit.enter') , class: "mx-auto w-1/2 bg-blue-500 text-white font-bold py-2 px-4 rounded mb-5 md:mb-8" %>
  </div>
  <% end %>
  <div id = "comments" class="max-w-lg md:max-w-xl mx-auto">
    <% if @board.comments.any? %>
      <% @board.comments.each do |comment| %>
        <ul class = "mb-15 ", id = "comment-<%=comment.id%>">
          <li class=" mb-3 mt-3 border-t border-gray-300">
            <div class="mt-3 flex justify-between">
              <div class="flex">
                <%= image_tag 'person_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.png' , class: 'w-6 h-6 ml-2 mr-3 ' %>
                <%= comment.user.decorate.full_name %>
              </div>
                <% if current_user.have?(comment) %>
              <div class="flex">
                  <%= link_to edit_board_path(@board) do %>
                    <%= image_tag 'edit_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.png' , class: 'w-6 h-6' %>
                    <% end %>
                  <%= link_to board_comment_path(@board,comment), data: { turbo_method: :delete, turbo_confirm: t('defaults.delete_confirm') } do %>
                    <span class="material-symbols-outlined mr-3">
                    delete
                    </span>
                  <% end %>
                <% end %>
              <div>
            </div>
            </li>
            <li class="ml-3 mb-3">
              <%= comment.body %>
            </li>
          <% end %>
        </ul>
      <% end %>
  </div>
</div>




