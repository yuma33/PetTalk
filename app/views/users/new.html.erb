<h1 class="text-center text-gray-700 md:text-3xl text-2xl font-bold mt-5 mb-2"><%= t('.title') %></h1>
<%= form_with model: @user, class: "w-full  max-w-lg md:max-w-xl mx-auto " do |f| %>
<%= render 'shared/error_messages', object: f.object %>
  <div class="flex flex-col -mx-3 mb-6">
    <div class="w-full  px-3 mb-6 md:mb-8">
      <%= f.label :last_name, class: "block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" %>
        <%= f.text_field :last_name,
          class: "appearance-none block w-full bg-gray-200 text-gray-700 border border-red-500 rounded py-3 px-4 mb-3 leading-tight focus:outline-none focus:bg-white"
          %>
    </div>
    <div class="w-full  px-3 mb-6 md:mb-8">
      <%= f.label :first_name, class: "block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" %>
        <%= f.text_field :first_name,
          class: "appearance-none block w-full bg-gray-200 text-gray-700 border border-red-500 rounded py-3 px-4 mb-3 leading-tight focus:outline-none focus:bg-white"
          %>
    </div>
    <div class="w-full  px-3 mb-6 md:mb-8">
      <%= f.label :email, class: "block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" %>
        <%= f.email_field :email,
          class: "appearance-none block w-full bg-gray-200 text-gray-700 border border-red-500 rounded py-3 px-4 mb-3 leading-tight focus:outline-none focus:bg-white"
          %>
    </div>
    <div class="w-full  px-3 mb-6 md:mb-8">
      <%= f.label :password, class: "block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" %>
        <%= f.password_field :password,
          class: "appearance-none block w-full bg-gray-200 text-gray-700 border border-gray-200 rounded py-3 px-4 mb-3 leading-tight focus:outline-none focus:bg-white focus:border-gray-500"
          %>
    </div>
    <div class="w-full  px-3 mb-6 md:mb-8">
      <%= f.label :password_confirmation, class: "block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" %>
        <%= f.password_field :password_confirmation,
          class: "appearance-none block w-full bg-gray-200 text-gray-700 border border-gray-200 rounded py-3 px-4 mb-3 leading-tight focus:outline-none focus:bg-white focus:border-gray-500"
          %>
    </div>
    <%= f.submit t('.enter') , class: "mx-auto w-1/2 bg-blue-500 text-white font-bold py-2 px-4 rounded mb-3 md:mb-6" %>
  <% end %>
    <div class='text-center md:mb-1'>
      <%= link_to t('.to_login_page') , login_path %>
    </div>
  </div>
